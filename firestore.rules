rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function admin(){return signedIn() && request.auth.token.admin==true && request.auth.token.email=='alimiranerr@gmail.com' && request.auth.token.email_verified==true;}
  function owner(uid){return signedIn() && request.auth.uid==uid;}
  function active(){return signedIn() && request.auth.token.email_verified==true && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.banned!=true;}
  function validProfile(data){
   return data.email is string
    && data.email==request.auth.token.email
    && data.displayName is string
    && data.displayName.size()<=80
    && (!data.keys().hasAny(['device']) || (data.device is string && data.device.size()<=40))
    && (!data.keys().hasAny(['surname']) || (data.surname is string && data.surname.size()<=80))
    && (!data.keys().hasAny(['school']) || (data.school is string && data.school.size()<=120))
    && (!data.keys().hasAny(['nickname']) || (data.nickname is string && data.nickname.size()<=40))
    && (!data.keys().hasAny(['className']) || (data.className is string && data.className.size()<=30))
    && (!data.keys().hasAny(['location']) || data.location is map)
    && (!data.keys().hasAny(['avatar']) || (data.avatar is string && data.avatar.size()<=8))
    && (!data.keys().hasAny(['avatarPath']) || (data.avatarPath is string && (data.avatarPath.size()==0 || data.avatarPath.matches('avatars/'+request.auth.uid+'/.*'))))
    && (!data.keys().hasAny(['status']) || data.status in ['online','sleep','offline'])
    && (!data.keys().hasAny(['statusUpdatedAt']) || data.statusUpdatedAt is timestamp);
  }
  function validAppearance(data){return data.keys().hasOnly(['bw','mode','theme','bgOn','bg','custom','c1','c2','effect','sound','vibration','updatedAt'])&&data.bw is bool&&data.mode in ['light','dark','auto']&&data.theme is int&&data.theme>=0&&data.theme<=4&&data.bgOn is bool&&data.bg is int&&data.bg>=0&&data.bg<=3&&data.custom is bool&&data.c1.matches('#[0-9a-fA-F]{6}')&&data.c2.matches('#[0-9a-fA-F]{6}')&&data.effect in ['none','sunny','rain','snow','auto']&&data.sound is bool&&data.vibration is bool&&data.updatedAt is timestamp;}
  function safeMessage(){
   return request.resource.data.keys().hasOnly(['senderId','senderName','text','mediaUrl','mediaPath','mediaType','createdAt','type'])
    && request.resource.data.senderId==request.auth.uid
    && request.resource.data.senderName is string
    && request.resource.data.senderName.size()<=80
    && request.resource.data.senderName==get(/databases/$(database)/documents/users/$(request.auth.uid)).data.displayName
    && request.resource.data.text is string
    && request.resource.data.text.size()<=4000
    && request.resource.data.type in ['text','media']
    && (!request.resource.data.keys().hasAny(['mediaUrl']) || (request.resource.data.mediaUrl is string && request.resource.data.mediaUrl.matches('https://.*')))
    && (!request.resource.data.keys().hasAny(['mediaPath']) || (request.resource.data.mediaPath is string && request.resource.data.mediaPath.size()<=500 && request.resource.data.mediaPath.matches('chatMedia/[^/]+/'+request.auth.uid+'_.*')))
    && (!request.resource.data.keys().hasAny(['mediaType']) || (request.resource.data.mediaType is string && request.resource.data.mediaType.matches('(image|audio|video)/[a-zA-Z0-9.+-]+')));
  }
  match /settings/{doc}{allow read:if doc in ['site','theme','curriculum','features']||admin();allow write:if admin();}
  match /users/{uid}{
   allow read:if owner(uid)||admin();
   allow create:if owner(uid)&&request.auth.token.email_verified==true&&request.resource.data.keys().hasOnly(['email','displayName','device','lastSeen','surname','school','nickname','className','location','avatar','avatarPath','status','statusUpdatedAt'])&&validProfile(request.resource.data);
   allow update:if admin()||(owner(uid)&&request.auth.token.email_verified==true&&request.resource.data.email==resource.data.email&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email','displayName','device','lastSeen','surname','school','nickname','className','location','avatar','avatarPath','status','statusUpdatedAt'])&&validProfile(request.resource.data));
   allow delete:if admin();
   match /preferences/{doc}{allow read:if owner(uid);allow create,update:if owner(uid)&&doc=='appearance'&&validAppearance(request.resource.data);allow delete:if owner(uid);}
  }
  match /chats/{chatId}{
   allow read:if active()&&(request.auth.uid in resource.data.memberIds||admin());
   allow create:if active()
    && request.resource.data.createdBy==request.auth.uid
    && request.resource.data.memberIds is list
    && request.resource.data.memberIds.size()>=2
    && request.resource.data.memberIds.size()<=10
    && request.auth.uid in request.resource.data.memberIds
    && request.resource.data.type in ['dm','group']
    && request.resource.data.title is string
    && request.resource.data.title.size()<=60
    && request.resource.data.keys().hasOnly(['memberIds','type','title','createdBy','createdAt']);
   allow update,delete:if admin();
   match /messages/{messageId}{
    allow read:if active()&&(request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds||admin());
    allow create:if active()&&request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds&&safeMessage();
    allow update:if admin();
    allow delete:if admin()||(active()&&resource.data.senderId==request.auth.uid);
   }
  }
  match /groups/{groupId}{
   allow read:if active()&&(request.auth.uid in resource.data.memberIds||admin());
   allow write:if admin();
   match /messages/{messageId}{
    allow read:if admin()||(active()&&request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds);
    allow create:if active()&&request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds&&safeMessage();
    allow update:if admin();
    allow delete:if admin()||(active()&&resource.data.senderId==request.auth.uid);
   }
  }
  match /users/{uid}/friends/{friendUid}{allow read:if owner(uid)||admin();allow write:if false;}
  match /users/{uid}/notifications/{notificationId}{allow read:if owner(uid)||admin();allow update:if owner(uid)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])&&request.resource.data.read is bool;allow create,delete:if false;}
  match /friendRequests/{id}{allow read:if signedIn()&&(resource.data.from==request.auth.uid||resource.data.to==request.auth.uid||admin());allow write:if false;}
  match /giftCodes/{code}{allow read:if admin();allow write:if false;}
  match /dailyTasks/{id}{allow read:if active()&&resource.data.active==true||admin();allow write:if false;}
  match /dailyTaskClaims/{id}{allow read:if admin()||(active()&&resource.data.uid==request.auth.uid);allow write:if false;}
  match /coinTransfers/{id}{allow read:if admin()||(active()&&(resource.data.from==request.auth.uid||resource.data.to==request.auth.uid));allow write:if false;}
  match /emailChangeLimits/{uid}{allow read:if owner(uid)||admin();allow write:if false;}
  match /coinTransferLimits/{uid}{allow read:if owner(uid)||admin();allow write:if false;}
  match /matchmakingQueue/{id}{allow read:if admin()||(active()&&resource.data.uid==request.auth.uid);allow write:if false;}
  match /market/{id}{allow read:if admin()||(active()&&resource.data.published==true);allow write:if false;}
  match /scores/{id}{allow read:if admin()||(active()&&(resource.data.public==true||resource.data.uid==request.auth.uid));allow write:if false;}
  match /groupCompetitions/{id}{allow read:if admin()||(active()&&((resource.data.membersA is list&&request.auth.uid in resource.data.membersA)||(resource.data.membersB is list&&request.auth.uid in resource.data.membersB)));allow write:if false;}
  match /duels/{id}{allow read:if admin()||(active()&&request.auth.uid in resource.data.players);allow write:if false;}
  match /wheelClaims/{uid}{allow read:if owner(uid)||admin();allow write:if false;}
  match /miniPassClaims/{uid}{allow read:if owner(uid)||admin();allow write:if false;}
  match /auditLogs/{id}{allow read:if admin();allow write:if false;}
  match /messageReports/{id}{allow read:if admin();allow write:if false;}
  match /feedback/{id}{allow read:if admin();allow write:if false;}
  match /teacherRequests/{id}{allow read:if admin();allow write:if false;}
  match /publicRateLimits/{id}{allow read,write:if false;}
  match /loginFailures/{id}{allow read:if admin();allow write:if false;}
  match /{path=**}/messages/{id}{allow read:if admin();}
  match /{document=**}{allow read,write:if false;}
 }
}
