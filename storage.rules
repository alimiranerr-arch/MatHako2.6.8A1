rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function signedIn(){return request.auth!=null;}
  function admin(){return signedIn()&&request.auth.token.admin==true&&request.auth.token.email=='alimiranerr@gmail.com';}
  function active(){return signedIn()&&firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.banned!=true;}
  match /chatMedia/{chatId}/{fileName}{allow read:if admin()||(active()&&request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.memberIds);allow create:if active()&&request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.memberIds&&request.resource.size<15*1024*1024&&request.resource.contentType.matches('image/.*|audio/.*|video/.*');allow delete:if admin();}
  match /market/{fileName}{allow read:if true;allow write:if admin()&&request.resource.size<10*1024*1024;}
 }
}
